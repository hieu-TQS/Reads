<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_mobile_yt_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Thumbnail 16:9 Full Width -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:aspectRatio="16:9">

        <ImageView
            android:id="@+id/img_yt_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222222"
            android:contentDescription="Thumbnail"
            android:scaleType="centerCrop"
            android:src="@drawable/grid_bg" />

        <TextView
            android:id="@+id/txt_yt_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#D9000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="14:25"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Info Row below Thumbnail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp">

        <!-- Channel Avatar -->
        <ImageView
            android:id="@+id/img_yt_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#33FFFFFF"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            app:tint="#FFD700" />

        <!-- Text Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_yt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tiêu đề video YouTube / SmartTube cực kỳ hấp dẫn"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_yt_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tên Kênh YouTube • 1.5M lượt xem • 2 ngày trước"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
