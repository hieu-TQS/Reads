<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#161618"
    android:padding="12dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/img_comment_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Avatar"
        android:src="@drawable/ic_user"
        app:tint="#FF6D00" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_comment_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Tác Giả"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_comment_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="2 ngày trước"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_comment_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nội dung bình luận..."
            android:textColor="#DDDDDD"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_comment_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="👍 12"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
