<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#121212">

    <!-- 1. Top Player Container (Strictly 16:9 Aspect Ratio) -->
    <FrameLayout
        android:id="@+id/player_video_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#000000">

        <!-- Surface / Player View for Video -->
        <FrameLayout
            android:id="@+id/player_surface_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.embedplayer.EmbedPlayerView
                android:id="@+id/embed_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Top-Left: Back Button -->
        <ImageButton
            android:id="@+id/btn_player_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#80000000"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_close_x"
            app:tint="#FFFFFF" />

        <!-- Top-Right: Fullscreen Button -->
        <ImageButton
            android:id="@+id/btn_player_fullscreen"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#80000000"
            android:contentDescription="Fullscreen"
            android:padding="8dp"
            android:src="@drawable/ic_fullscreen"
            app:tint="#FFFFFF" />

        <!-- Loading Progress -->
        <ProgressBar
            android:id="@+id/player_loading_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 2. Content below player (Scrollable in Portrait mode) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/player_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/player_video_container"
        app:layout_constraintBottom_toTopOf="@id/player_bottom_tab_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Media Info: Single Line Marquee Title -->
            <TextView
                android:id="@+id/txt_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:text="Tiêu đề Video YouTube"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Subtitle Row: Views • Likes • Published Date -->
            <TextView
                android:id="@+id/txt_player_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1.2M lượt xem • 👍 50K • 2 ngày trước"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <!-- Channel Row & Red Borderless Heart Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Channel Logo (Left) -->
                <ImageView
                    android:id="@+id/img_channel_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_user"
                    app:tint="#FF6D00" />

                <!-- Channel Name (Row 1) & Subscriber Count (Row 2) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_channel_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên Kênh YouTube"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_channel_subs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100K Người đăng ký"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Share Button (Borderless) -->
                <ImageButton
                    android:id="@+id/btn_player_share"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Chia sẻ"
                    android:padding="6dp"
                    android:src="@drawable/ic_share"
                    app:tint="#CCCCCC" />

                <!-- Favorite Heart Button (Far Right, Red Color, No Background, No Border) -->
                <ImageButton
                    android:id="@+id/btn_player_favorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Yêu thích"
                    android:padding="6dp"
                    android:src="@drawable/ic_favorite"
                    app:tint="#FF2C2C" />
            </LinearLayout>

            <!-- Hidden Movie/IPTV Views -->
            <TextView
                android:id="@+id/lbl_quick_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_horizontal_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#222222" />

            <!-- TAB CONTAINER 1: Related Videos List -->
            <LinearLayout
                android:id="@+id/container_tab_related"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_vertical_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- TAB CONTAINER 2: Full Description -->
            <LinearLayout
                android:id="@+id/container_tab_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="MÔ TẢ VIDEO CHI TIẾT"
                    android:textColor="#FF6D00"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_full_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Đang tải mô tả video..."
                    android:textColor="#EEEEEE"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- TAB CONTAINER 3: Video Comments -->
            <LinearLayout
                android:id="@+id/container_tab_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="BÌNH LUẬN VIDEO"
                    android:textColor="#FF6D00"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Comment Input Box (Visible when signed in) -->
                <LinearLayout
                    android:id="@+id/layout_add_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="#1C1C1E"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_user"
                        app:tint="#FF6D00" />

                    <EditText
                        android:id="@+id/edt_add_comment"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#2C2C2E"
                        android:hint="Viết bình luận của bạn..."
                        android:textColorHint="#888888"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSend" />

                    <ImageButton
                        android:id="@+id/btn_send_comment"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_play_arrow"
                        app:tint="#FF6D00"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Gửi bình luận" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_comments"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Bottom Navigation Bar on Player Page (Consistent with IPTV style) -->
    <LinearLayout
        android:id="@+id/player_bottom_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#181820"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Back Tab Button -->
        <LinearLayout
            android:id="@+id/btn_tab_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trở về"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- List Tab Button -->
        <LinearLayout
            android:id="@+id/btn_tab_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tab_list"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_btn_list"
                app:tint="#FF6D00" />

            <TextView
                android:id="@+id/txt_tab_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh sách"
                android:textColor="#FF6D00"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Description Tab Button -->
        <LinearLayout
            android:id="@+id/btn_tab_desc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tab_desc"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info"
                app:tint="#888888" />

            <TextView
                android:id="@+id/txt_tab_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô tả"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Comments Tab Button -->
        <LinearLayout
            android:id="@+id/btn_tab_comments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tab_comments"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_cc"
                app:tint="#888888" />

            <TextView
                android:id="@+id/txt_tab_comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bình luận"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Fullscreen Tab Button -->
        <LinearLayout
            android:id="@+id/btn_tab_fullscreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tab_fullscreen"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_fullscreen"
                app:tint="#888888" />

            <TextView
                android:id="@+id/txt_tab_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toàn màn hình"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
